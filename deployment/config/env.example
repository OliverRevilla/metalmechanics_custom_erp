# Copy to deployment/.env after resolving and recording real digests.
# No credentials belong in this file.
SITE_NAME=metalmecanica.localhost
MARIADB_IMAGE=
REDIS_IMAGE=
# Independent API: set these locally; never commit the real password.
INDEPENDENT_ADMIN_USERNAME=admin
INDEPENDENT_ADMIN_EMAIL=admin@example.invalid
INDEPENDENT_ADMIN_PASSWORD=replace-with-a-long-local-password
# Development only: seed repeatable customers, orders, projects and PDFs.
INDEPENDENT_SEED_DUMMY_DATA=true
# Restore only: bundle directory name under deployment/backups and a NEW site name.
BACKUP_BUNDLE=
RESTORE_SITE_NAME=
